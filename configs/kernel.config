CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7

# Memory
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_HUGETLBFS=y
CONFIG_MEMORY_HOTPLUG=y

# Boot options
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="quiet splash boot=live loglevel=3"
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_EMBEDDED=y
